{
  "name": "@ethindia/agent-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "dev": "tsup src/index.ts --dts --format esm,cjs --watch",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "@types/node": "^20.11.17",
    "vitest": "^1.6.0"
  }
}

