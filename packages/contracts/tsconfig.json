{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "hardhat"],
    "resolveJsonModule": true
  },
  "include": ["hardhat.config.ts", "scripts", "test", "src"],
  "exclude": ["node_modules"]
}

